# Copia este archivo a .env y rellena los valores reales.
# Nunca subas el archivo .env con credenciales reales al repositorio.

# Configuración general del proyecto
APP_NAME=Directo a Obra
APP_ENV=local
APP_DEBUG=true

# Configuración de base de datos
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=directoaobra
DB_USERNAME=root
DB_PASSWORD=

# Claves de pago y servicios externos
CLIENTE_ID=tu_cliente_id_aqui
KEY_TOKEN=tu_key_token_aqui
CURRENCY=MXN
MONEDA=$
